# Google Wallet (server-side only)
# Issuer ID from Google Pay & Wallet Console
GOOGLE_WALLET_ISSUER_ID=3388000000023187816
GOOGLE_WALLET_CLASS_SUFFIX=rezix_loyalty_v1
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=rezix-wallet@project-636be4e8-5ddd-481e-8c3.iam.gserviceaccount.com
# Paste the private_key from a NEW service-account JSON key. Keep it server-side only.
# On Vercel, the PEM can be stored with literal \\n sequences.
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_WITH_NEW_KEY\\n-----END PRIVATE KEY-----\\n"
NEXT_PUBLIC_APP_URL=https://rezix.at

