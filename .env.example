# PostgreSQL (Supabase). Use the Transaction Pooler URL on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Supabase Storage (server-side only). NEVER expose the service-role key to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Rezix global administrator
REZIX_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
REZIX_ADMIN_PASSWORD_SALT=YOUR_PBKDF2_SALT
REZIX_ADMIN_PASSWORD_HASH=YOUR_PBKDF2_HASH

# Generate a unique long random value for production.
REZIX_SESSION_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# v0.5 Legal / GDPR display data
REZIX_LEGAL_COMPANY=Rezix
REZIX_LEGAL_OWNER=Ahmed Rezek
REZIX_LEGAL_ADDRESS=Ihre Geschäftsanschrift
REZIX_LEGAL_EMAIL=support@rezix.at
REZIX_PRIVACY_EMAIL=privacy@rezix.at
REZIX_LEGAL_PHONE=
REZIX_LEGAL_VAT=
REZIX_LEGAL_COUNTRY=Österreich

# v0.6 Authentication
# Public canonical app URL used in verification/reset emails.
NEXT_PUBLIC_APP_URL=https://loyalty.rezix.at

# Transactional email (Resend). Required in production for verification/reset links.
RESEND_API_KEY=re_xxxxxxxxx
REZIX_EMAIL_FROM=Rezix <noreply@rezix.at>

# v0.7 Stripe Billing (server-side secrets)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Create recurring Prices in Stripe and paste each price_... ID here.
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxxxxxxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxxxxxxxx
# Set true only after Stripe Tax / automatic tax is configured for your account.
STRIPE_AUTOMATIC_TAX=false

# Optional explainer video URL; default: /media/rezix-explainer.mp4
NEXT_PUBLIC_REZIX_EXPLAINER_VIDEO=
